# Ejemplo para Nginx. Ajusta root/server_name según tu servidor.
server {
  listen 80;
  server_name ejemplo.com;
  root /var/www/semilla_appweb_pwa_autoactualizable;
  index index.html;

  add_header X-Content-Type-Options nosniff always;
  add_header X-Frame-Options DENY always;
  add_header Referrer-Policy strict-origin-when-cross-origin always;
  add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
  add_header Cross-Origin-Opener-Policy same-origin always;
  add_header Cross-Origin-Resource-Policy same-origin always;
  add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-lRCdaGVhvfFFcJSwJg4kkkgh4L2jLFOwnrADoTSirvY='; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; manifest-src 'self'; worker-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;

  location = / {
    add_header Cache-Control "no-store, max-age=0, must-revalidate" always;
    try_files /index.html =404;
  }

  location = /index.html {
    add_header Cache-Control "no-store, max-age=0, must-revalidate" always;
  }

  location = /sw.js {
    add_header Cache-Control "no-store, max-age=0, must-revalidate" always;
    add_header Service-Worker-Allowed "/" always;
  }

  location = /version.json {
    add_header Cache-Control "no-store, max-age=0, must-revalidate" always;
  }

  location = /health.json {
    add_header Cache-Control "no-store, max-age=0, must-revalidate" always;
  }

  location = /manifest.webmanifest {
    add_header Cache-Control "no-cache, max-age=0, must-revalidate" always;
  }

  location /src/ {
    add_header Cache-Control "public, max-age=86400, stale-while-revalidate=604800" always;
  }

  location /textX/ {
    add_header Cache-Control "public, max-age=86400, stale-while-revalidate=604800" always;
  }

  location /assets/ {
    add_header Cache-Control "public, max-age=604800, stale-while-revalidate=2592000" always;
  }

  location /P2P_sin_RED_LOCALx/ {
    add_header Cache-Control "public, max-age=86400, stale-while-revalidate=604800" always;
    try_files $uri =404;
  }

  location / {
    try_files $uri $uri/ /index.html;
  }
}
