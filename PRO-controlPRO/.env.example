# La aplicación no necesita una variable para su carpeta pública. El identificador P2P se deriva
# automáticamente de la ruta donde está instalada: raíz => "root"; /contabilidad/ => "contabilidad".
# Esa ruta debe estar aprobada en P2P_APLICACIONES_APROBADAS del backend.

# Variable pública usada durante el build del Static Site de Render.
# El build debe ejecutar: python tools/generate-release.py --require-backend
# En el panel de Render guárdala sin comillas exteriores.
APP_BACKEND_URL=https://tu-backend.onrender.com

# Bool público opcional. Con true intenta primero memoriaBACKEND y, cuando no está
# disponible, habilita el bloque P2P_sin_ para conexiones WebRTC ya emparejadas.
# Para autenticar identidad y permisos sin conexión, memoriaBACKEND debe emitir capacidades
# con P2P_SIN_CAPABILITY_PRIVATE_JWK/PUBLIC_JWK antes de que el dispositivo quede offline.
sinBACKEND=false

APP_PUBLIC_NAME="Semilla App Web"
APP_PUBLIC_VERSION="1.0.0"
APP_PUBLIC_BUILD="release"
APP_PUBLIC_UPDATE_CHANNEL="stable"
